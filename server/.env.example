PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/mpgi-lost-found
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# First user registering with this email becomes admin
ADMIN_EMAIL=admin@mpgi.edu

# Cloudinary (leave blank to store images locally in server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail (leave blank to disable emails; use a Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
